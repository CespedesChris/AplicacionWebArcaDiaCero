@model Arca.Data.Models.Semilla

<h2>Eliminar Semilla</h2>
<h4>¿Está seguro que desea eliminar esta semilla?</h4>
<div>

    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>
        <dt class="col-sm-2">Cantidad</dt>
        <dd class="col-sm-10">@Model.Cantidad</dd>
        <dt class="col-sm-2">Fecha Almacenamiento</dt>
        <dd class="col-sm-10">@Model.FechaAlmacenamiento.ToString("yyyy-MM-dd")</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.IdSemilla" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>
