@model Arca.Data.Models.Especie

<h2>Eliminar Especie</h2>
<h4>¿Está seguro que desea eliminar esta especie?</h4>
<div>

    <dl class="row">
        <dt class="col-sm-2">Nombre Cientifico</dt>
        <dd class="col-sm-10">@Model.NombreCientifico</dd>
        <dt class="col-sm-2">Nombre Comun</dt>
        <dd class="col-sm-10">@Model.NombreComun</dd>
        <dt class="col-sm-2">Familia</dt>
        <dd class="col-sm-10">@Model.Familia</dd>
        <dt class="col-sm-2">Descripcion</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.IdEspecie" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>
