@model Arca.MVC.Models.ReporteFiltroViewModel

<h2>Generar Reporte de Inventario</h2>

<form asp-action="Resultado" asp-controller="Reporte" method="post" class="mt-3">

    <div class="row">
        <div class="col-md-3">
            <label class="form-label">Fecha Inicio</label>
            <input type="date" asp-for="FechaInicio" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Fecha Fin</label>
            <input type="date" asp-for="FechaFin" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Especie</label>
            <select asp-for="EspecieId" asp-items="Model.Especies" class="form-select">
                <option value="">-- Todas --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Ubicación</label>
            <select asp-for="UbicacionId" asp-items="Model.Ubicaciones" class="form-select">
                <option value="">-- Todas --</option>
            </select>
        </div>
    </div>

    <!--<button type="submit" class="btn btn-primary mt-3">Generar</button>-->
    <!--      DE ACA PARA ABAJO SE PUSO LO NUEVO  -->
    <div class="mt-3 d-flex gap-2">
        <!-- Generar (usa POST a /Reporte/Resultado) -->
        <button type="submit" class="btn btn-primary" formaction="@Url.Action("Resultado", "Reporte")">
            Generar
        </button>

        <!-- Mostrar panel para programar -->
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('panelProgramar').classList.toggle('d-none')">
            Programar reporte
        </button>

        <a class="btn btn-outline-info" asp-action="Programados" asp-controller="Reporte">Ver programaciones</a>
    </div>

    <div id="panelProgramar" class="card card-body mt-3 d-none">
        <h5>Parámetros de programación</h5>
        <div class="row">
            <div class="col-md-3">
                <label class="form-label">Formato</label>
                <select asp-for="Formato" class="form-select">
                    <option value="pdf">PDF</option>
                    <option value="xlsx">Excel</option>
                    <option value="csv">CSV</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Frecuencia</label>
                <select asp-for="Frecuencia" class="form-select">
                    <option value="unico">Único</option>
                    <option value="diaria">Diaria</option>
                    <option value="semanal">Semanal</option>
                    <option value="mensual">Mensual</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Fecha/Hora de envío</label>
                <input asp-for="ProximoEnvio" type="datetime-local" class="form-control" />
            </div>

            <div class="col-md-12 mt-2">
                <label class="form-label">Destinatarios (correos separados por coma)</label>
                <input asp-for="Destinatarios" class="form-control" placeholder="ej: correo1@dom.com, correo2@dom.com" />
            </div>
        </div>

        <div class="mt-3">
            <!-- Guardar programación (usa POST a /Reporte/Programar) -->
            <button type="submit" class="btn btn-success" formaction="@Url.Action("Programar", "Reporte")">
                Guardar programación
            </button>
        </div>
    </div>


    
    

</form>