
@model IEnumerable<Arca.Data.Models.SemillaViewModel>
@{
    ViewData["Title"] = "Resultado del Reporte";
}

<h2>Resultado del Reporte</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay datos para los filtros seleccionados.</div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Especie</th>
                <th>Ubicación</th>
                <th>Cantidad</th>
                <th>Fecha de Almacenamiento</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Nombre</td>
                    <td>@(s.NombreEspecie ?? s.IdEspecie.ToString())</td> @* Ajusta: si tienes NombreEspecie, úsalo; si no, muestra IdEspecie *@
                    <td>@(s.NombreUbicacion ?? s.IdEspecie.ToString())</td>
                    <td>@s.Cantidad</td>
                    <td>@s.FechaAlmacenamiento.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a class="btn btn-danger"
           asp-action="Exportar"
           asp-route-formato="pdf"
           asp-route-fechaInicio="@ViewBag.FechaInicio"
           asp-route-fechaFin="@ViewBag.FechaFin"
           asp-route-especieId="@ViewBag.EspecieId"
           asp-route-ubicacionId="@ViewBag.UbicacionId">
            Exportar a PDF
        </a>

        <a class="btn btn-success"
           asp-action="Exportar"
           asp-route-formato="xlsx"
           asp-route-fechaInicio="@ViewBag.FechaInicio"
           asp-route-fechaFin="@ViewBag.FechaFin"
           asp-route-especieId="@ViewBag.EspecieId"
           asp-route-ubicacionId="@ViewBag.UbicacionId">
            Exportar a Excel
        </a>

        <a class="btn btn-info"
           asp-action="Exportar"
           asp-route-formato="csv"
           asp-route-fechaInicio="@ViewBag.FechaInicio"
           asp-route-fechaFin="@ViewBag.FechaFin"
           asp-route-especieId="@ViewBag.EspecieId"
           asp-route-ubicacionId="@ViewBag.UbicacionId">
            Exportar a CSV
        </a>
    </div>
}

<a asp-action="Index" class="btn btn-secondary mt-3">Volver</a>