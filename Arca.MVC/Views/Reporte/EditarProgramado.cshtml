@model Arca.Data.Models.ReporteProgramado

<h2>Editar Programación</h2>

<form asp-action="EditarProgramado" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-md-6">
            <label class="form-label">Nombre</label>
            <input asp-for="NombreReporte" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Formato</label>
            <select asp-for="Formato" class="form-select">
                <option value="pdf">PDF</option>
                <option value="xlsx">Excel</option>
                <option value="csv">CSV</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Frecuencia</label>
            <select asp-for="Frecuencia" class="form-select">
                <option value="unico">Único</option>
                <option value="diaria">Diaria</option>
                <option value="semanal">Semanal</option>
                <option value="mensual">Mensual</option>
            </select>
        </div>

        <div class="col-md-4 mt-2">
            <label class="form-label">Próximo envío</label>
            <input asp-for="ProximoEnvio" type="datetime-local" class="form-control" />
        </div>
        <div class="col-md-8 mt-2">
            <label class="form-label">Destinatarios</label>
            <input asp-for="Destinatarios" class="form-control" />
        </div>

        <div class="col-12 mt-2">
            <label class="form-label">Parametros (JSON)</label>
            <textarea asp-for="Parametros" rows="5" class="form-control"></textarea>
            <small class="text-muted">Puedes ajustar manualmente los filtros en JSON si lo deseas.</small>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-success" type="submit">Guardar</button>
        <a asp-action="Programados" class="btn btn-secondary">Volver</a>
    </div>
</form>